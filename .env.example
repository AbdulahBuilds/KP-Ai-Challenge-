# ==============================================================================
# Environment Configuration - Hospital Referral & Coordination System
# ==============================================================================

# 1. Google Gemini AI API Key (Optional but recommended for live LLM triage analysis)
# If omitted or invalid, the system automatically falls back to the built-in clinical rule heuristic engine.
GEMINI_API_KEY=

# 2. MongoDB Atlas Connection String (Optional for local development, recommended for Vercel/production)
# If omitted, the system automatically uses the zero-config local JSON file store (data/db.json).
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/hospital_db?retryWrites=true&w=majority
MONGODB_URI=

# 3. Server Port (Default: 3000)
PORT=3000
