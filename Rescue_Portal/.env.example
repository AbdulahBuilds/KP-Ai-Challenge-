# ---------------------------------------------------------------------------
# Rescue Portal environment configuration (placeholders only - never commit secrets)
# Copy to .env (root) before running with Docker Compose.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PROXY_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Database (MongoDB Atlas) ----------------------------------------------
# Include the database name in the path and URL-encode special characters in the password.
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rescue_portal?retryWrites=true&w=majority

# --- Redis (caching, rate limiting, optional pub/sub) ----------------------
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# --- JWT (generate strong random values, e.g. openssl rand -hex 48) --------
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-random-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Application security --------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# NEVER enable in production. Exposes invitation/password-reset tokens in API responses for local development.
EXPOSE_DEV_TOKENS=true
MAX_UPLOAD_BYTES=10485760


# --- Rescue Admin (required for seeding; keep credentials out of source control) ---
RESCUE_ADMIN_EMAIL=
RESCUE_ADMIN_PASSWORD=

# --- Storage ---------------------------------------------------------------
# local | s3  (local stores files privately under STORAGE_LOCAL_DIR)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rescue-attachments
S3_ACCESS_KEY=rescue-minio
S3_SECRET_KEY=change-me-minio-secret
S3_FORCE_PATH_STYLE=true

# --- Hospital integration --------------------------------------------------
# mock | http   (mock is clearly labelled in API responses and UI)
HOSPITAL_ADAPTER=mock
HOSPITAL_API_BASE_URL=https://hospital-portal.example.invalid/integration/v1
HOSPITAL_API_KEY=
HOSPITAL_API_TIMEOUT_MS=8000
HOSPITAL_DATA_MAX_AGE_SECONDS=300
HOSPITAL_REQUEST_TIMEOUT_SECONDS=120
# Demo mock API route can also require a key: /api/v1/mock/hospital-api/v1
MOCK_HOSPITAL_API_KEY=
MOCK_HOSPITAL_CENTER_LAT=31.5204
MOCK_HOSPITAL_CENTER_LNG=74.3587

# --- Patient integration ---------------------------------------------------
# mock | http
PATIENT_ADAPTER=mock
PATIENT_API_BASE_URL=https://patient-portal.example.invalid/integration/v1
PATIENT_API_KEY=
PATIENT_API_TIMEOUT_MS=10000

# --- Maps integration ------------------------------------------------------
# mock-haversine | google | osrm
MAPS_ADAPTER=mock-haversine
GOOGLE_MAPS_API_KEY=
OSRM_BASE_URL=https://router.project-osrm.org
MAPS_AVERAGE_SPEED_KMH=42
MAPS_ROAD_FACTOR=1.35
MAPS_API_TIMEOUT_MS=8000

# --- AI assistance (deterministic heuristic fallback always available) ----
# heuristic | http
AI_ADAPTER=heuristic
AI_API_BASE_URL=
AI_API_KEY=
AI_API_TIMEOUT_MS=10000

# --- Frontend map tiles ----------------------------------------------------
# Leave empty to show a clearly-labelled schematic coordinate map.
# Example (OpenStreetMap public tiles): https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# --- Background workers ----------------------------------------------------
WORKERS_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=5000
HOSPITAL_POLL_INTERVAL_MS=15000
LOCATION_RETENTION_DAYS=30
GPS_STALE_AFTER_SECONDS=90

# --- API behaviour ---------------------------------------------------------
ENABLE_SWAGGER=true
# Set true only behind a trusted reverse proxy.
TRUST_PROXY=false
# ONLY for controlled demos. Production rejects HOSPITAL_ADAPTER=mock by default.
ALLOW_MOCK_IN_PRODUCTION=false
