// Rescue Portal - MongoDB schema (PostGIS enabled via migration SQL)
// All timestamps stored in UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum OrganizationStatus {
  PENDING
  VERIFIED
  SUSPENDED
  REJECTED
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum AmbulanceType {
  BASIC_LIFE_SUPPORT
  ADVANCED_LIFE_SUPPORT
  MOBILE_ICU
  NEONATAL
  PATIENT_TRANSPORT
}

enum AmbulanceStatus {
  AVAILABLE
  ASSIGNED
  DISPATCHED
  EN_ROUTE
  ON_SCENE
  TRANSPORTING
  AT_HOSPITAL
  OUT_OF_SERVICE
}

enum TeamStatus {
  AVAILABLE
  ASSIGNED
  ON_SCENE
  TRANSPORTING
  OFF_DUTY
}

enum IncidentStatus {
  RECEIVED
  REGISTERED
  REVIEWED
  DISPATCHED
  EN_ROUTE
  ON_SCENE
  TRANSPORTING
  AT_HOSPITAL
  HANDOVER_IN_PROGRESS
  HANDOVER_COMPLETED
  CLOSED
  CANCELLED
  FAILED
}

enum Severity {
  CRITICAL
  HIGH
  MODERATE
  LOW
  UNKNOWN
}

enum EmergencyType {
  MEDICAL
  TRAUMA
  CARDIAC
  RESPIRATORY
  OBSTETRIC
  PEDIATRIC
  NEONATAL
  PSYCHIATRIC
  BURNS
  MASS_CASUALTY
  OTHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum AssignmentStatus {
  ACTIVE
  RELEASED
  COMPLETED
}

enum CaseEventType {
  EMERGENCY_RECEIVED
  CASE_REGISTERED
  CASE_REVIEWED
  AMBULANCE_ASSIGNED
  TEAM_ASSIGNED
  DISPATCH_CONFIRMED
  EN_ROUTE
  ARRIVED_AT_PATIENT
  PATIENT_CONTACT_ESTABLISHED
  TRANSPORT_STARTED
  HOSPITAL_DESTINATION_SELECTED
  HOSPITAL_NOTIFIED
  HOSPITAL_ACCEPTED
  HOSPITAL_REJECTED
  HOSPITAL_RESPONSE_TIMEOUT
  ARRIVED_AT_HOSPITAL
  HANDOVER_STARTED
  HANDOVER_COMPLETED
  CASE_CLOSED
  CASE_CANCELLED
  CASE_FAILED
  OBSERVATION_ADDED
  STATUS_CHANGED
  LOCATION_UPDATED
  ATTACHMENT_ADDED
  HOSPITAL_TRANSFER
  NOTE_ADDED
}

enum EquipmentStatus {
  READY
  MAINTENANCE
  MISSING
}

enum HospitalRequestStatus {
  PENDING
  ACKNOWLEDGED
  ACCEPTED
  REJECTED
  MORE_INFO
  TIMED_OUT
  FAILED
  CANCELLED
}

enum FreshnessStatus {
  FRESH
  STALE
  EXPIRED
  UNKNOWN
}

enum EligibilityStatus {
  ELIGIBLE
  UNCONFIRMED
  INELIGIBLE
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD
}

enum IntegrationDataSource {
  MOCK
  LIVE
}

enum HandoverDisposition {
  ADMITTED
  EMERGENCY_DEPARTMENT
  ICU
  OPERATING_THEATRE
  TRANSFERRED
  DECEASED
  LEFT_WITHOUT_BEING_SEEN
  OTHER
}

// ---------------------------------------------------------------------------
// Identity, organization, RBAC
// ---------------------------------------------------------------------------

model Organization {
  id                 String             @id @default(uuid()) @map("_id")
  name               String
  code               String             @unique
  registrationNumber String?            @unique
  status             OrganizationStatus @default(PENDING)
  email              String
  phone              String
  address            String?
  city               String?
  country            String             @default("Pakistan")
  latitude           Float?
  longitude          Float?
  verifiedAt         DateTime?
  rejectedReason     String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users         User[]
  teams         RescueTeam[]
  ambulances    Ambulance[]
  incidents     Incident[]
  notifications Notification[]
  auditLogs     AuditLog[]
  invitations   Invitation[]
  hospitalReqs  HospitalRequest[]

  @@index([status])
  @@map("organizations")
}

model User {
  id             String     @id @default(uuid()) @map("_id")
  organizationId String?
  email          String     @unique
  passwordHash   String
  firstName      String
  lastName       String
  phone          String?
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  suspendedReason String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  roles          UserRole[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  teamMemberships TeamMember[]
  createdIncidents Incident[]  @relation("IncidentCreatedBy")
  assignments    IncidentAssignment[] @relation("AssignmentAssignedBy")
  observations   IncidentObservation[]
  caseEvents     CaseEvent[] @relation("CaseEventActor")
  auditLogs      AuditLog[]
  notifications  Notification[]
  uploads        Attachment[]
  selectedRecommendations HospitalRecommendation[] @relation("RecommendationSelectedBy")
  handovers      HandoverRecord[]
  invitations    Invitation[] @relation("InvitationInvitedBy")

  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @map("_id")
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @map("_id")
  code        String   @unique
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid()) @map("_id")
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id         String   @id @default(uuid()) @map("_id")
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RefreshToken {
  id           String    @id @default(uuid()) @map("_id")
  userId       String
  tokenHash    String    @unique
  familyId     String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @map("_id")
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Invitation {
  id             String    @id @default(uuid()) @map("_id")
  organizationId String
  email          String
  roleCode       String
  tokenHash      String    @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Rescue resources
// ---------------------------------------------------------------------------

model RescueTeam {
  id             String     @id @default(uuid()) @map("_id")
  organizationId String
  name           String
  code           String
  status         TeamStatus @default(AVAILABLE)
  baseLatitude   Float?
  baseLongitude  Float?
  baseAddress    String?
  shiftStart     String?
  shiftEnd       String?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  assignments  IncidentAssignment[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("rescue_teams")
}

model TeamMember {
  id            String   @id @default(uuid()) @map("_id")
  teamId        String
  userId        String
  qualification String?
  isLeader      Boolean  @default(false)
  joinedAt      DateTime @default(now())

  team RescueTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Ambulance {
  id                 String          @id @default(uuid()) @map("_id")
  organizationId     String
  registrationNumber String
  vehicleId          String?
  type               AmbulanceType
  model              String?
  status             AmbulanceStatus @default(AVAILABLE)
  capabilities       String[]        @default([])
  baseLatitude       Float?
  baseLongitude      Float?
  baseAddress        String?
  currentLatitude    Float?
  currentLongitude   Float?
  lastLocationAt     DateTime?
  inspectionDueAt    DateTime?
  maintenanceDueAt   DateTime?
  notes              String?
  archivedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipment    AmbulanceEquipment[]
  assignments  IncidentAssignment[]
  locations    AmbulanceLocation[]

  @@unique([organizationId, registrationNumber])
  @@index([organizationId, status])
  @@map("ambulances")
}

model AmbulanceEquipment {
  id            String          @id @default(uuid()) @map("_id")
  ambulanceId   String
  name          String
  code          String?
  status        EquipmentStatus @default(READY)
  quantity      Int             @default(1)
  lastCheckedAt DateTime?
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  ambulance Ambulance @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)

  @@index([ambulanceId])
  @@map("ambulance_equipment")
}

// ---------------------------------------------------------------------------
// Incidents
// ---------------------------------------------------------------------------

model Incident {
  id             String         @id @default(uuid()) @map("_id")
  caseNumber     String         @unique
  organizationId String
  createdById    String?
  status         IncidentStatus @default(RECEIVED)
  severity       Severity       @default(UNKNOWN)
  emergencyType  EmergencyType  @default(OTHER)
  title          String
  summary        String?
  latitude       Float
  longitude      Float
  address        String?
  locationAccuracyMeters Float?
  locationCapturedAt DateTime?
  requiredCapabilities String[] @default([])
  destinationHospitalId   String?
  destinationHospitalName String?
  activeAmbulanceId String?
  activeTeamId      String?
  cancellationReason String?
  outcome        String?
  receivedAt     DateTime       @default(now())
  registeredAt   DateTime?
  reviewedAt     DateTime?
  dispatchedAt   DateTime?
  onSceneAt      DateTime?
  transportStartedAt DateTime?
  atHospitalAt   DateTime?
  handoverCompletedAt DateTime?
  closedAt       DateTime?
  cancelledAt    DateTime?
  failedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  patient        IncidentPatientDetails?
  observations   IncidentObservation[]
  assignments    IncidentAssignment[]
  events         CaseEvent[]
  locations      AmbulanceLocation[]
  hospitalRequests HospitalRequest[]
  recommendations HospitalRecommendation[]
  handover       HandoverRecord?
  attachments    Attachment[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, severity])
  @@index([latitude, longitude])
  @@map("incidents")
}

model IncidentPatientDetails {
  id               String   @id @default(uuid()) @map("_id")
  incidentId       String   @unique
  patientName      String?
  age              Int?
  dateOfBirth      DateTime?
  gender           Gender   @default(UNKNOWN)
  unidentified     Boolean  @default(false)
  contactPhone     String?
  emergencyContactName  String?
  emergencyContactPhone String?
  suspectedCondition String?
  symptoms         String?
  injuries         String?
  medicalHistory   String?
  allergies        String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@map("incident_patient_details")
}

model IncidentObservation {
  id         String   @id @default(uuid()) @map("_id")
  incidentId String
  authorId   String?
  note       String
  vitals     Json?
  createdAt  DateTime @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("incident_observations")
}

model IncidentAssignment {
  id           String           @id @default(uuid()) @map("_id")
  incidentId   String
  ambulanceId  String?
  teamId       String?
  assignedById String?
  status       AssignmentStatus @default(ACTIVE)
  assignedAt   DateTime         @default(now())
  releasedAt   DateTime?
  releaseReason String?
  notes        String?

  incident  Incident   @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  ambulance Ambulance? @relation(fields: [ambulanceId], references: [id], onDelete: SetNull)
  team      RescueTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)
  assignedBy User?     @relation("AssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([incidentId, status])
  @@index([ambulanceId, status])
  @@index([teamId, status])
  @@map("incident_assignments")
}

model CaseEvent {
  id         String        @id @default(uuid()) @map("_id")
  incidentId String
  type       CaseEventType
  message    String
  actorId    String?
  metadata   Json?
  occurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation("CaseEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, occurredAt])
  @@map("case_events")
}

model AmbulanceLocation {
  id              String   @id @default(uuid()) @map("_id")
  ambulanceId     String
  incidentId      String?
  latitude        Float
  longitude       Float
  accuracyMeters  Float?
  speedKph        Float?
  headingDegrees  Float?
  deviceId        String?
  capturedAt      DateTime
  receivedAt      DateTime @default(now())
  createdById     String?

  ambulance Ambulance @relation(fields: [ambulanceId], references: [id], onDelete: Cascade)
  incident  Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  @@index([ambulanceId, capturedAt])
  @@index([incidentId, capturedAt])
  @@map("ambulance_locations")
}

model HandoverRecord {
  id                    String             @id @default(uuid()) @map("_id")
  incidentId            String             @unique
  handoverById          String?
  receivingClinicianName String?
  receivingFacilityName String?
  disposition           HandoverDisposition @default(EMERGENCY_DEPARTMENT)
  handoverAt            DateTime
  patientCondition      String?
  notes                 String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  handoverBy User?  @relation(fields: [handoverById], references: [id], onDelete: SetNull)

  @@map("handover_records")
}

model Attachment {
  id           String    @id @default(uuid()) @map("_id")
  incidentId   String
  uploadedById String?
  fileName     String
  contentType  String
  sizeBytes    Int
  storageKey   String    @unique
  checksum     String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@map("attachments")
}

// ---------------------------------------------------------------------------
// Hospital integration
// ---------------------------------------------------------------------------

model HospitalDirectoryCache {
  id                 String              @id @default(uuid()) @map("_id")
  externalHospitalId String              @unique
  name               String
  address            String?
  city               String?
  latitude           Float
  longitude          Float
  phone              String?
  services           String[]            @default([])
  isMock             Boolean             @default(true)
  dataSource         IntegrationDataSource @default(MOCK)
  sourceFetchedAt    DateTime            @default(now())
  raw                Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([latitude, longitude])
  @@map("hospital_directory_cache")
}

model HospitalAvailabilitySnapshot {
  id                 String              @id @default(uuid()) @map("_id")
  hospitalExternalId String
  hospitalName       String?
  capabilities       Json
  sourceResponseId   String
  observedAt         DateTime
  expiresAt          DateTime
  freshness          FreshnessStatus     @default(UNKNOWN)
  isMock             Boolean             @default(true)
  dataSource         IntegrationDataSource @default(MOCK)
  raw                Json?
  createdAt          DateTime            @default(now())

  @@index([hospitalExternalId, observedAt])
  @@map("hospital_availability_snapshots")
}

model HospitalRequest {
  id                 String               @id @default(uuid()) @map("_id")
  incidentId         String
  organizationId     String
  hospitalExternalId String
  hospitalName       String
  status             HospitalRequestStatus @default(PENDING)
  correlationId      String               @unique
  idempotencyKey     String               @unique
  requestPayload     Json
  responsePayload    Json?
  responseMessage    String?
  requestedCapabilities String[]          @default([])
  etaMinutes         Int?
  sentAt             DateTime?
  respondedAt        DateTime?
  lastCheckedAt      DateTime?
  attemptCount       Int                  @default(0)
  lastError          String?
  isMock             Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([incidentId, status])
  @@index([organizationId, createdAt])
  @@map("hospital_requests")
}

model HospitalRecommendation {
  id                       String   @id @default(uuid()) @map("_id")
  incidentId               String
  policyVersion            String
  policy                   Json
  results                  Json
  candidateCount           Int
  eligibleCount            Int
  unconfirmedCount         Int
  ineligibleCount          Int
  selectedHospitalId       String?
  selectedHospitalName     String?
  selectedById             String?
  selectedAt               DateTime?
  dataSource               IntegrationDataSource @default(MOCK)
  mapsSource               String   @default("mock-haversine")
  createdAt                DateTime @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  selectedBy User?    @relation("RecommendationSelectedBy", fields: [selectedById], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@map("hospital_recommendations")
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

model Notification {
  id             String               @id @default(uuid()) @map("_id")
  userId         String
  organizationId String?
  type           String
  title          String
  body           String
  severity       NotificationSeverity @default(INFO)
  isRead         Boolean              @default(false)
  readAt         DateTime?
  data           Json?
  deliveryStatus String               @default("DELIVERED")
  createdAt      DateTime             @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model IntegrationOutbox {
  id           String       @id @default(uuid()) @map("_id")
  aggregateType String
  aggregateId  String
  eventType    String
  payload      Json
  status       OutboxStatus @default(PENDING)
  attempts     Int          @default(0)
  maxAttempts  Int          @default(5)
  nextAttemptAt DateTime    @default(now())
  lastError    String?
  processedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([aggregateType, aggregateId])
  @@map("integration_outbox")
}

model AuditLog {
  id             String   @id @default(uuid()) @map("_id")
  organizationId String?
  actorId        String?
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
